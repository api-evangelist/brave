{
  "opencollection": "1.0.0",
  "info": {
    "name": "Brave Ads campaigns images API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Image Search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ads-serve.brave.com/images/search",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Image search query string."
              },
              {
                "name": "country",
                "value": "",
                "type": "query",
                "description": "Country code or ALL for worldwide results."
              },
              {
                "name": "search_lang",
                "value": "",
                "type": "query",
                "description": "Preferred content language (ISO 639-1)."
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of image results to return. Default 50, max 200."
              },
              {
                "name": "safesearch",
                "value": "",
                "type": "query",
                "description": "Content filtering level. Default is strict for images."
              },
              {
                "name": "spellcheck",
                "value": "",
                "type": "query",
                "description": "Enable autocorrection of the search query. Default true."
              }
            ]
          },
          "docs": "Search for images from the Brave independent index."
        }
      ]
    }
  ],
  "bundled": true
}