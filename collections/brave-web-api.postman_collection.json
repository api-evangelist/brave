      "item": [
        {
          "id": "adff59ff-80b2-4853-b66b-7ff4ab3f319d",
          "name": "Web Search",
          "request": {
            "name": "Web Search",
            "description": {
              "content": "Search across billions of indexed web pages with fast, reliable results. Supports search operators, geographic targeting, language filtering, date freshness, safe search controls, and rich data enrichments across 20+ verticals.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "web",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Search query string. Supports search operators including exact phrase matching (quotes), term exclusion (minus), site-specific search (site:), and file type filtering (filetype:).\n"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "2-character country code for geographic targeting (e.g. US, GB, DE)."
                },
                {
                  "disabled": false,
                  "key": "search_lang",
                  "value": "<string>",
                  "description": "ISO 639-1 language code for content language preference (e.g. en, es, fr)."
                },
                {
                  "disabled": false,
                  "key": "ui_lang",
                  "value": "<string>",
                  "description": "Language code for response metadata and UI strings."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "20",
                  "description": "Number of results per page. Maximum is 20."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset (0-based). Maximum is 9."
                },
                {
                  "disabled": false,
                  "key": "safesearch",
                  "value": "moderate",
                  "description": "Safe search content filtering level. Options: off, moderate (default), or strict.\n"
                },
                {
                  "disabled": false,
                  "key": "freshness",
                  "value": "<string>",
                  "description": "Date-based freshness filter. Use pd (past 24 hours), pw (past week), pm (past month), py (past year), or a custom date range in the format YYYY-MM-DDtoYYYY-MM-DD.\n"
                },
                {
                  "disabled": false,
                  "key": "extra_snippets",
                  "value": "false",
                  "description": "When true, returns up to 5 additional text excerpts per result."
                },
                {
                  "disabled": false,
                  "key": "enable_rich_callback",
                  "value": "0",
                  "description": "Enable rich data enrichments. Set to 1 to enable rich result callbacks for verticals like weather, stocks, sports, and more.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
