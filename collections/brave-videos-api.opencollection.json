{
  "opencollection": "1.0.0",
  "info": {
    "name": "Brave Ads campaigns videos API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "videos",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Video Search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ads-serve.brave.com/videos/search",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Video search query string."
              },
              {
                "name": "country",
                "value": "",
                "type": "query",
                "description": "2-character country code for geographic targeting."
              },
              {
                "name": "search_lang",
                "value": "",
                "type": "query",
                "description": "ISO 639-1 language code for content language."
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of results per page. Max 50, default 20."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset (0-based). Maximum is 9."
              },
              {
                "name": "safesearch",
                "value": "",
                "type": "query",
                "description": "Content filtering level."
              },
              {
                "name": "freshness",
                "value": "",
                "type": "query",
                "description": "Date freshness filter (pd, pw, pm, py, or custom range)."
              },
              {
                "name": "spellcheck",
                "value": "",
                "type": "query",
                "description": "Enable autocorrection. Default true."
              }
            ]
          },
          "docs": "Search for videos from the Brave independent index."
        }
      ]
    }
  ],
  "bundled": true
}