                "local",
                "pois"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>,<string>",
                  "description": "(Required) Comma-separated list of location IDs from web search (max 20)."
                },
                {
                  "disabled": false,
                  "key": "search_lang",
                  "value": "<string>",
                  "description": "ISO 639-1 language preference for results."
                },
                {
                  "disabled": false,
                  "key": "ui_lang",
                  "value": "<string>",
                  "description": "UI language for response metadata."
                },
                {
                  "disabled": false,
